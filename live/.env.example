# Copy to live/.env and fill in. Auto-loaded by live/config.py (python-dotenv).
# In Claude Cowork, set these as env vars/secrets instead. Do NOT commit live/.env.

# Alpaca (paper)
ALPACA_API_KEY=your-alpaca-paper-key
ALPACA_SECRET_KEY=your-alpaca-paper-secret
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Postgres
PG_HOST=your-postgres-host
PG_PORT=5432
PG_DB=root_db
PG_USER=postgres
PG_PASSWORD=your-postgres-password
PG_SCHEMA=pmvwft68q3g8g19

# Telegram (REQUIRED for notifications) — from @BotFather -> befreedombot -> API Token
TELEGRAM_BOT_TOKEN=
# Optional: pre-seed recipient chat_ids (comma-separated)
TELEGRAM_SEED_CHAT_IDS=

# Risk sizing (defaults: 1% per trade, max 5 positions = 5% total)
RISK_PER_TRADE=0.01
MAX_POSITIONS=5
